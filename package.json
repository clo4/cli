{
  "name": "@clo4/cli",
  "version": "6.0.0",
  "description": "clo4's CLI framework: fully declarative, typed from your spec, fast",
  "keywords": [
    "arg-parser",
    "args",
    "argument-parser",
    "cli",
    "command-line",
    "help",
    "options",
    "shell-completion",
    "subcommands",
    "type-safe",
    "typescript"
  ],
  "homepage": "https://clo4.github.io/cli/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clo4/cli.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:bench": "tsdown --config tsdown.bench.config.ts",
    "bench": "pnpm build && pnpm build:bench && node bench/dist/run.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.bench.json --noEmit",
    "test": "vitest run",
    "fuzz": "vitest run test/fuzz",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "verify": "pnpm fmt:check && pnpm lint && pnpm check && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@cliffy/command": "jsr:^1.3.1",
    "@drizzle-team/brocli": "^0.12.1",
    "@effect/platform-node": "^4.1.2",
    "@oclif/core": "^5.1.11",
    "@optique/core": "^1.3.6",
    "@optique/run": "^1.3.6",
    "@stricli/core": "^1.3.0",
    "@types/node": "^26.6.6",
    "cac": "^7.1.0",
    "citty": "^0.2.2",
    "clerc": "^1.3.1",
    "clipanion": "4.0.0-rc.4",
    "cmd-ts": "^0.15.0",
    "commander": "^15.1.0",
    "effect": "^4.1.2",
    "gunshi": "^0.37.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "rolldown": "^1.2.16",
    "sade": "^1.8.1",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yargs": "^18.2.0"
  },
  "packageManager": "pnpm@12.16.1"
}
