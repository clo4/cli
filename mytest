#!/usr/bin/env node

import * as CLI from "./dist/index.js";
import { choice, seq, uint, optional } from "./dist/index.js";

const spec = CLI.spec({
  name: "mytest",
  args: {
    name: "duration",
    parse: seq(optional("amount"), uint, choice("s", "sec", "seconds", "m", "min", "minutes")),
  },
  subcommands: [
    CLI.completion
  ]
})

CLI.run(spec);
