{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 110,
  "ignorePatterns": ["**/node_modules/**", "**/dist/**"],
  "overrides": [
    {
      "files": ["**/*.md"],
      "options": {
        "proseWrap": "never",
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
