---
import Layout from "@/layouts/Layout.astro";
import { Blog } from "@/components/blog";
import InlineCode from "@/components/InlineCode.astro";
import { formatDate, getPosts } from "@/lib/blog";
import { appName } from "@/lib/shared";

export const prerender = true;

const posts = getPosts();
---

<Layout title={`Blog · ${appName}`} description={`Release announcements and articles about ${appName}`}>
  <Blog client:load transition:persist="blog" pathname={Astro.url.pathname} params={Astro.params}>
    <h1 class="text-3xl font-semibold mb-2">Blog</h1>
    <p class="text-fd-muted-foreground mb-10">Updates and articles about the library.</p>
    <ul class="flex flex-col gap-8">
      {
        posts.map((post) => (
          <li>
            <a href={post.url} class="group block">
              <time class="text-sm text-fd-muted-foreground" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <h2 class="text-xl font-medium group-hover:underline">{post.data.title}</h2>
              {
                post.data.description && (
                  <p class="text-fd-muted-foreground">
                    <InlineCode text={post.data.description} />
                  </p>
                )
              }
            </a>
          </li>
        ))
      }
    </ul>
  </Blog>
</Layout>
