---
import Base from "@/layouts/Base.astro";
import InlineCode from "@/components/InlineCode.astro";
import PageHeader from "@/components/PageHeader.astro";
import { t } from "@/i18n";
import { formatDate, getPosts } from "@/lib/blog";
import { href } from "@/lib/shared";

export const prerender = true;

const posts = getPosts();
---

<Base title={t("blog.title")} description={t("blog.description")} image={href("og/blog.png")} current="blog">
  <main class="page">
    <PageHeader title="blog.title" rss={href("blog/rss.xml")} />
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={post.url}>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, "short")}</time>
              <h2>{post.data.title}</h2>
              {post.data.description && (
                <p>
                  <InlineCode text={post.data.description} />
                </p>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  ul {
    margin-top: 8px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    border-bottom: 1px solid var(--line);
  }
  li a {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 4px 24px;
    padding: 22px 0;
    text-decoration: none;
    &:hover h2 {
      color: var(--muted);
    }
  }
  time {
    padding-top: 4px;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  h2 {
    margin: 0;
    font: 400 var(--title-sm) / 1.25 var(--display);
    transition: color var(--ease);
  }
  p {
    grid-column: 2;
    margin: 0;
    font-size: 15px;
    color: var(--muted);
    & :global(code) {
      font-size: 0.88em;
    }
  }
  @media (width < 640px) {
    li a {
      grid-template-columns: 1fr;
    }
    p {
      grid-column: 1;
    }
  }
</style>
