---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import InlineCode from "@/components/InlineCode.astro";
import PrevNext from "@/components/PrevNext.astro";
import Markdown from "@/components/Markdown.astro";
import T from "@/components/T.astro";
import { blog, formatDate, getPosts } from "@/lib/blog";
import { href, site } from "@/lib/shared";

export const prerender = true;

export const getStaticPaths = (() => {
  return blog.getPages().map((post) => ({
    params: { slug: decodeURI(post.slugs.join("/")) },
    props: { post },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props;
const { body: Content } = await post.data.load();
const posts = getPosts();
const at = posts.findIndex((other) => other.url === post.url);
const older = posts[at + 1];
const newer = posts[at - 1];
---

<Base
  title={post.data.title}
  description={post.data.description?.replaceAll("`", "")}
  image={href(`og/blog/${post.slugs.join("/")}.png`)}
  type="article"
  current="blog"
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description?.replaceAll("`", ""),
      datePublished: post.data.date.toISOString(),
      url: new URL(post.url, site).href,
      image: new URL(href(`og/blog/${post.slugs.join("/")}.png`), site).href,
    })}
  />
  <main class="page">
    <header>
      <a class="back" href={href("blog")}><Icon name="left" /><T k="blog.back" /></a>
      <h1 class="title">{post.data.title}</h1>
      {
        post.data.description && (
          <p class="lead">
            <InlineCode text={post.data.description} />
          </p>
        )
      }
      <p class="meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p>
    </header>
    <Markdown as="article" content={Content} />
    <PrevNext
      previous={older && { url: older.url, name: older.data.title }}
      next={newer && { url: newer.url, name: newer.data.title }}
      previousLabel="blog.older"
      nextLabel="blog.newer"
    />
  </main>
</Base>

<style>
  header {
    margin-bottom: 32px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 28px;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    &:hover {
      color: var(--fg);
    }
  }
  .lead {
    margin: 12px 0 0;
    font-size: var(--text-lead);
    color: var(--muted);
  }
  .meta {
    margin: 14px 0 0;
    font-size: var(--text-ui);
    color: var(--muted);
  }
</style>
