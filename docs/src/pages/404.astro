---
import Base from "@/layouts/Base.astro";
import T from "@/components/T.astro";
import { t } from "@/i18n";
import { href } from "@/lib/shared";
---

<Base title={t("notFound.title")}>
  <main class="page">
    <h1 class="title"><T k="notFound.title" /></h1>
    <p><T k="notFound.body" /></p>
    <p><a href={href("docs")}><T k="notFound.home" /></a></p>
  </main>
</Base>

<style>
  main {
    padding-top: 96px;
  }
  h1 {
    margin-bottom: 12px;
  }
  p {
    color: var(--muted);
  }
  a {
    color: var(--fg);
  }
</style>
