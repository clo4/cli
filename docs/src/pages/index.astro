---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import T from "@/components/T.astro";
import CopyButton from "@/components/CopyButton.astro";
import Stage from "@/components/landing/Stage.astro";
import { t } from "@/i18n";
import { getPosts } from "@/lib/blog";
import { githubUrl, href, site, version } from "@/lib/shared";

const latest = getPosts()[0];
const install = "npm install @clo4/cli";
/** The sentences of `text`, so the lead can wrap between them and not inside one where there's room. */
const sentences = (text: string) =>
  [...new Intl.Segmenter("en", { granularity: "sentence" }).segment(text)].map(({ segment }) => segment.trim());
---

<Base current="home">
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareSourceCode",
      name: "@clo4/cli",
      description: t("site.description"),
      url: new URL(href(), site).href,
      codeRepository: githubUrl,
      programmingLanguage: "TypeScript",
      runtimePlatform: "Node.js",
      license: "https://opensource.org/licenses/MIT",
      version,
    })}
  />
  <main>
    <section class="hero">
      {
        latest && (
          <a class="pill" href={latest.url}>
            <b>
              <T k="landing.new" />
            </b>
            <span>{latest.data.title}</span>
            <Icon name="right" size={14} />
          </a>
        )
      }
      <h1><T k="landing.title" /></h1>
      <p class="lead">{sentences(t("landing.lead")).map((sentence) => <span>{sentence}</span>)}</p>
      <div class="actions">
        <CopyButton class="large mono install" text={install} aria-label={t("landing.copy")}>
          <span class="command"><span class="prompt">$</span> {install}</span>
        </CopyButton>
        <a class="button large primary" href={href("docs")}><T k="landing.docs" /><Icon name="right" size={14} /></a>
      </div>
    </section>
    <Stage />
  </main>
</Base>

<style>
  main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 72px;
    padding: 72px 0 96px;
  }
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 var(--page-gutter);
    text-align: center;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    margin-bottom: 36px;
    padding: 4px 12px 4px 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: var(--text-sm);
    color: var(--muted);
    text-decoration: none;
    transition:
      color var(--ease),
      border-color var(--ease);
    &:hover {
      color: var(--fg);
      border-color: var(--line-strong);
    }
    & span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    & b {
      flex: none;
      padding: 1px 8px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--bg);
      font-size: 12px;
      font-weight: 500;
      color: var(--fg);
    }
  }
  h1 {
    max-width: 13em;
    margin: 0;
    font: 400 var(--title-hero) / 1.05 var(--display);
    text-wrap: balance;
  }
  .lead {
    margin: 24px 0 0;
    font-size: var(--text-lead);
    color: var(--muted);
    /* Each sentence is a box, so a line breaks between them. One longer than
       the line still wraps inside. */
    & span {
      display: inline-block;
      text-wrap: balance;
    }
    & span + span {
      margin-inline-start: 0.3em;
    }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 36px;
  }
  .install {
    border-color: var(--line);
    background: var(--surface);
    color: var(--fg);
    & .prompt {
      color: var(--faint);
    }
    & :global(.icon) {
      color: var(--muted);
    }
  }
  @media (width < 640px) {
    main {
      gap: 48px;
      padding: 40px 0 64px;
    }
    .pill {
      margin-bottom: 28px;
      font-size: var(--text-xs);
    }
    .lead {
      margin-top: 16px;
      font-size: var(--text-body);
    }
    .actions {
      flex-direction: column;
      align-self: stretch;
      margin-top: 28px;
    }
  }
</style>
