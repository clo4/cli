---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import T from "@/components/T.astro";
import Stage from "@/components/landing/Stage.astro";
import { t } from "@/i18n";
import { getPosts } from "@/lib/blog";
import { githubUrl, href, site, version } from "@/lib/shared";

const latest = getPosts()[0];
---

<Base current="home">
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareSourceCode",
      name: "@clo4/cli",
      description: t("site.description"),
      url: new URL(href(), site).href,
      codeRepository: githubUrl,
      programmingLanguage: "TypeScript",
      runtimePlatform: "Node.js",
      license: "https://opensource.org/licenses/MIT",
      version,
    })}
  />
  <main>
    <section class="hero">
      {
        latest && (
          <a class="pill" href={latest.url}>
            <b>
              <T k="landing.new" />
            </b>
            <span>{latest.data.title}</span>
            <Icon name="right" size={14} />
          </a>
        )
      }
      <h1><T k="landing.title" /></h1>
      <p class="lead"><T k="landing.lead" /></p>
      <div class="actions">
        <button class="install" data-install="npm install @clo4/cli" aria-label={t("landing.copy")}>
          <span class="prompt">$</span>npm install @clo4/cli<Icon name="copy" />
        </button>
        <a class="docs" href={href("docs")}><T k="landing.docs" /><Icon name="right" size={14} /></a>
      </div>
    </section>
    <div class="stage-wrap">
      <Stage />
    </div>
  </main>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-install]")) {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.install!);
      button.dataset.copied = "";
      setTimeout(() => delete button.dataset.copied, 1200);
    });
  }
</script>

<style>
  main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 64px;
    padding: 80px 0 96px;
  }
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 0 24px;
    text-align: center;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    padding: 4px 12px 4px 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 13.5px;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--ease);
    &:hover {
      color: var(--fg);
    }
    & span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    & b {
      flex: none;
      padding: 1px 8px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--bg);
      font-size: 12px;
      font-weight: 500;
      color: var(--fg);
    }
  }
  h1 {
    margin: 0;
    font: 400 clamp(30px, 8.4vw, 64px) / 1.05 var(--display);
    letter-spacing: -0.02em;
    max-width: 13em;
    text-wrap: balance;
  }
  .lead {
    max-width: 52ch;
    margin: 0;
    font-size: 18px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .install,
  .docs {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 14px;
    border-radius: var(--radius-inner);
    font-size: 14px;
    text-decoration: none;
    transition:
      background-color var(--ease),
      color var(--ease);
  }
  .install {
    border: 1px solid var(--line);
    background: var(--surface);
    font-family: var(--mono);
    cursor: pointer;
    & .prompt {
      color: var(--faint);
    }
    & :global(.icon) {
      color: var(--muted);
    }
    &[data-copied] :global(.icon) {
      color: var(--fg);
    }
  }
  .docs {
    background: var(--fg);
    color: var(--bg);
    font-weight: 500;
  }
  .stage-wrap {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }
  @media (width < 760px) {
    main {
      gap: 40px;
      padding: 40px 0 64px;
    }
    .hero {
      gap: 16px;
      padding: 0 16px;
    }
    .pill {
      font-size: 12.5px;
    }
    .lead {
      font-size: 16px;
    }
    .actions {
      flex-direction: column;
      align-self: stretch;
      align-items: stretch;
      & > * {
        justify-content: center;
      }
    }
    .stage-wrap {
      padding: 0;
    }
  }
</style>
