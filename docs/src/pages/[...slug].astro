---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Layout from "@/layouts/Layout.astro";
import { Docs } from "@/components/docs";
import PageLink from "@/components/PageLink.astro";
import { source } from "@/lib/source";
import { appName, getPageMarkdownUrl, gitConfig } from "@/lib/shared";

export const prerender = true;

export const getStaticPaths = (() => {
  return source.getPages().map((page) => ({
    params: { slug: decodeURI(page.slugs.join("/")) || undefined },
    props: { page },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props;
const { body: Content, toc } = await page.data.load();
const pageTree = await source.serializePageTree(source.getPageTree());

// A page of the working docs says so, and links to the same page of the
// newest release, or to that release's first page if it has no such page.
let unreleased: { version: string; url: string } | undefined;
if (page.slugs[0] === "next") {
  const versions = [...new Set(source.getPages().map((other) => other.slugs[0]))]
    .filter((slug) => /^v\d+$/.test(slug))
    .sort((a, b) => Number(b.slice(1)) - Number(a.slice(1)));
  const version = versions[0];
  const released = version && (source.getPage([version, ...page.slugs.slice(1)]) ?? source.getPage([version]));
  if (released) {
    unreleased = { version, url: released.url };
  }
}
---

<Layout title={`${page.data.title} · ${appName}`} description={page.data.description}>
  <Docs
    client:load
    transition:persist="docs"
    pathname={page.url}
    params={Astro.params}
    tree={pageTree}
    title={page.data.title}
    description={page.data.description}
    toc={toc}
    markdownUrl={getPageMarkdownUrl(page).url}
    githubUrl={`https://github.com/${gitConfig.user}/${gitConfig.repo}/blob/${gitConfig.branch}/docs/content/docs/${encodeURI(page.path)}`}
    unreleased={unreleased}
  >
    <Content components={{ a: PageLink }} />
  </Docs>
</Layout>
