---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Markdown from "@/components/Markdown.astro";
import T from "@/components/T.astro";
import { t } from "@/i18n";
import { blog, formatDate } from "@/lib/blog";
import { getReleases, getUnreleased } from "@/lib/changelog";
import { href } from "@/lib/shared";

export const prerender = true;

const unreleased = getUnreleased();
const pending = unreleased && (await unreleased.data.load());
const hasPending = Boolean(pending?.structuredData.contents.length || pending?.structuredData.headings.length);
const releases = await Promise.all(
  getReleases().map(async (release) => ({
    version: release.data.title,
    date: release.data.date,
    Content: (await release.data.load()).body,
    post: blog.getPage([`v${release.data.title}`]),
  })),
);
---

<Base title={t("changelog.title")} description={t("changelog.description")} image={href("og/changelog.png")} current="changelog">
  <main class="page">
    <PageHeader title="changelog.title" rss={href("changelog/rss.xml")} />
    {
      hasPending && pending && (
        <section class="release" id="unreleased">
          <div class="when">
            <h2>
              <a href="#unreleased">
                <T k="changelog.unreleased" />
              </a>
            </h2>
            <span>
              <T k="changelog.onMain" />
            </span>
          </div>
          <Markdown content={pending.body} />
        </section>
      )
    }
    {
      releases.map(({ version, date, Content, post }) => (
        <section class="release" id={`v${version}`}>
          <div class="when">
            <h2>
              <a href={`#v${version}`}>{version}</a>
            </h2>
            {date && <time datetime={date.toISOString()}>{formatDate(date, "short")}</time>}
          </div>
          <Markdown content={Content}>
            {post && (
              <p>
                <a href={post.url}>
                  <T k="changelog.post" />
                </a>
              </p>
            )}
          </Markdown>
        </section>
      ))
    }
  </main>
</Base>

<style>
  .page {
    --page-width: 860px;
  }
  .release {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 24px;
    padding: 36px 0;
    border-bottom: 1px solid var(--line);
  }
  .when {
    position: sticky;
    top: calc(var(--header) + 24px);
    align-self: start;
    & h2 {
      margin: 0;
      font: 400 var(--title-sm) / 1.2 var(--display);
      & a {
        text-decoration: none;
      }
    }
    & :is(time, span) {
      font-size: 14px;
      color: var(--muted);
    }
  }
  .release .prose :global(h2) {
    margin-top: 32px;
    font-size: 20px;
  }
  .release .prose :global(h3) {
    font-size: 16px;
  }
  @media (width < 640px) {
    .release {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .when {
      position: static;
    }
  }
</style>
