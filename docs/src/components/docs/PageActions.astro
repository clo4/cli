---
import CopyButton from "@/components/CopyButton.astro";
import Icon from "@/components/Icon.astro";
import T from "@/components/T.astro";
import { t } from "@/i18n";

interface Props {
  markdownUrl: string;
  editUrl: string;
}

const { markdownUrl, editUrl } = Astro.props;
---

<div class="actions">
  <CopyButton url={markdownUrl} label={t("docs.copyMarkdown")} />
  <a class="button" href={editUrl}><Icon name="pen" /><T k="docs.edit" /></a>
</div>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 24px 0 32px;
  }
</style>
