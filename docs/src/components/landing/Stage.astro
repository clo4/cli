---
import { codeToTokens, createCssVariablesTheme } from "shiki";
import { t } from "@/i18n";
import type { PlaygroundProps, Source } from "@/playground/components/Playground";
import { specRanges } from "@/playground/ranges";
import { scenarios } from "@/playground/scenarios";

const files = import.meta.glob<string>("/src/playground/scenarios/**/*.ts", {
  query: "?raw",
  import: "default",
  eager: true,
});
const theme = createCssVariablesTheme({ name: "tokens", variablePrefix: "--shiki-" });
const escape = (text: string) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

/** Each line of `source`, highlighted. */
async function highlight(source: string): Promise<string[]> {
  const { tokens } = await codeToTokens(source.trimEnd(), { lang: "ts", theme });
  return tokens.map((line) =>
    line.map((token) => `<span style="color:${token.color}">${escape(token.content)}</span>`).join(""),
  );
}

const sources: Record<string, Source> = {};
for (const { path } of scenarios.flatMap((scenario) => scenario.files)) {
  const source = files[`/src/playground/scenarios/${path}`];
  sources[path] = { code: await highlight(source), ranges: specRanges(source) };
}
const props: PlaygroundProps = {
  tabs: Object.fromEntries(scenarios.map((scenario) => [scenario.id, t(scenario.tab)])),
  sources,
  copy: {
    label: t("stage.label"),
    input: t("stage.input"),
    result: t("stage.result"),
    problems: t("stage.problems"),
    output: t("stage.output"),
    notFound: t("stage.notFound"),
    program: t("stage.kind.program"),
    subcommand: t("stage.kind.subcommand"),
    option: t("stage.kind.option"),
    value: t("stage.kind.value"),
    argument: t("stage.kind.argument"),
    separator: t("stage.kind.separator"),
    optionAction: t("stage.optionAction"),
  },
};
---

<div class="playground" data-playground={JSON.stringify(props)}></div>

<script>
  import { mount } from "@/playground/mount";
  mount();
</script>

<style>
  /* Holds the playground's place until it's drawn in the browser. */
  .playground:empty {
    width: min(1280px, 100% - 2 * var(--page-gutter));
    min-height: 720px;
    margin: 0 auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--sunken);
  }
  @media (width < 860px) {
    .playground:empty {
      width: 100%;
      min-height: 960px;
      border-inline: 0;
      border-radius: 0;
    }
  }
</style>
